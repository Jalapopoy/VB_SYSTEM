                <span class="glyphicon glyphicon-plus"></span>@Html.ActionLink("Edit Product Information", "EditProduct", new { id = Model.id }, new {@class = "text-white text-decocation-none"})
            </div>
            <div class="btn btn-secondary pull-right m-b-15px">
                <span class="glyphicon glyphicon-plus"></span>@Html.ActionLink("Back to Product List", "Index", null, new { @class = "text-white text-decoration-none" })
            </div>
        </td>
    </tr>   
