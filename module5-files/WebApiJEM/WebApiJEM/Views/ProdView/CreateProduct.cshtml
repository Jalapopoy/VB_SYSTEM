@model WebApiJEM.Models.ProductViewModel

@{
    ViewBag.Title = "CreateProduct";
}

<br />
<h2 style="margin-left:10px">CreateProduct</h2>
<br />

@using (Html.BeginForm()) {
    @Html.ValidationSummary(true)

    <form action="#" method="post" border="0">
        @Html.AntiForgeryToken()
        @if(ViewBag.Message != null)
        {
            <div style="border:solid 1px green">
                @ViewBag.Message
            </div>
        }
        <table class="table">
            <tr>
                <td>
                    <div class="editor-label">
                        @Html.LabelFor(model => model.id)
                    </div>
                </td>
                <td>
                    <div class="editor-field">
                        @Html.TextBoxFor(model => model.id, null, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.id)
                    </div>
                </td>
            </tr>

            <tr>
                <td>
                    <div class="editor-label">
                        @Html.LabelFor(model => model.name)
                    </div>
                </td>
                <td>
                    <div class="editor-field">
                        @Html.TextBoxFor(model => model.name, null, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.name)
                    </div>
                </td>
            </tr>

            <tr>
                <td>
                    <div class="editor-label">
                        @Html.LabelFor(model => model.description)
                    </div>
                </td>
                <td>
                    <div class="editor-field">
                        @Html.TextBoxFor(model => model.description, null, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.description)
                    </div>
                </td>
            </tr>

            <tr>
                <td>
                    <div class="editor-label">
                        @Html.LabelFor(model => model.price)
                    </div>
                </td>
                <td>
                    <div class="editor-field">
                        @Html.TextBoxFor(model => model.price, null, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.price)
                    </div>
                </td>
            </tr>

            <tr>
                <td>
                    <div class="editor-label">
                        @Html.LabelFor(model => model.category_id)
                    </div>
                </td>
                <td>
                    <div class="editor-field">
                        @Html.TextBoxFor(model => model.category_id, null, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.category_id)
                    </div>
                </td>
            </tr>
            <tr>
                <td>
                    <button type="button" class="btn btn-link">

                    </button>
                </td>
                <td>
                    <button type="submit" class="btn btn-secondary">
                        <span class="glyphicon glyphicon-plus"></span>Submit Product Informartion
                    </button>
                    <div class="btn btn-secondary pull-right m-b-15px">
                        <span class="glyphicon glyphicon-plus"></span>@Html.ActionLink("Back to Product List", "Index", null, new { @class = "text-white text-decoration-none"})
                    </div>
                </td>
            </tr>
        </table>
    </form>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
