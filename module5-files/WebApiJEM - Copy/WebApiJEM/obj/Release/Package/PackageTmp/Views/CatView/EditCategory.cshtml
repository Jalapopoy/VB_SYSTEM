@model WebApiJEM.Models.CategoryViewModel

@{
    ViewBag.Title = "EditCategory";
}

<br />
<h2 style="margin-left:10px">EditCategory</h2>
<br />

@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)

    @Html.AntiForgeryToken()

    if (ViewBag.Message != null)
    {
        <div style="border:solid 1px green">
            @ViewBag.Message
        </div>
    }

    @Html.HiddenFor(model => model.id)

    <table class="table">
        <tr>
            <td>
                <div>
                    @Html.LabelFor(model => model.id)
                </div>
            </td>
            <td>
                <div class="editor-field">
                    @Html.TextBoxFor(model => model.id, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.id)
                </div>
            </td>
        </tr>

        <tr>
            <td>
                <div class="editor-label">
                    @Html.LabelFor(model => model.name)
                </div>
            </td>
            <td>
                <div class="editor-field">
                    @Html.TextBoxFor(model => model.name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.name)
                </div>
            </td>
        </tr>

        <tr>
            <td>
                <div class="editor-label">
                    @Html.LabelFor(model => model.description)
                </div>
            </td>
            <td>
                <div class="editor-field">
                    @Html.TextBoxFor(model => model.description, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.description)
                </div>
            </td>
        </tr>

        <tr>
            <td>
                <button type="button" class="btn btn-link"></button>
            </td>
            <td>
                <button type="submit" class="btn btn-secondary">
                    <span class="glyphicon glyphicon-plus"></span>
                    Submit Category Information
                </button>

                <div class="btn btn-secondary pull-right m-b-15px">
                    <span class="glyphicon glyphicon-plus"></span>
                    @Html.ActionLink(
                        "Back to Category List",
                        "Index",
                        null,
                        new { @class = "text-white text-decoration-none" })
                </div>
            </td>
        </tr>
    </table>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}