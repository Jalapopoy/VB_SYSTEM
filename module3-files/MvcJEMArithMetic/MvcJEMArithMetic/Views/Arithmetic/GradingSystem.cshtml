@model MvcJEMArithMetic.Models.Grade

@{
    ViewBag.Title = "GradingSystem";
}

<h2>GradingSystem</h2>
@using (Html.BeginForm("GradingSystem", "Arithmetic", FormMethod.Post))
{
    <table>
        <tr>
            <td>
                @Html.LabelFor(model => model.PGradeJEM)
            </td>
            <td>
                @Html.TextBoxFor(model => model.PGradeJEM)
                @Html.ValidationMessageFor(model => model.PGradeJEM)
            </td>
        </tr>
        <tr>
            <td>
                @Html.LabelFor(model => model.MGradeJEM)
            </td>
            <td>
                @Html.TextBoxFor(model => model.MGradeJEM)
                @Html.ValidationMessageFor(model => model.MGradeJEM)
            </td>
        </tr>
        <tr>
            <td>
                @Html.LabelFor(model => model.FGradeJEM)
            </td>
            <td>
                @Html.TextBoxFor(model => model.FGradeJEM)
                @Html.ValidationMessageFor(model => model.FGradeJEM)
            </td>
        </tr>
        <tr>
            <td>
                @Html.LabelFor(model => model.SGradeJEM)
            </td>
            <td>
                @Html.TextBoxFor(model => model.SGradeJEM, new { @Value = ViewBag.Grade, @readonly = "readonly" })
                @Html.ValidationMessageFor(model => model.SGradeJEM)
            </td>
        </tr>
        <tr>
            <td></td>
            <td><input type="submit" value="COMPUTE GRADE" /></td>
        </tr>
    </table>
}