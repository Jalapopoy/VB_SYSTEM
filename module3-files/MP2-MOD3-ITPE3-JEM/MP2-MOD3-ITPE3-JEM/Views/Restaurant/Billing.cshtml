@model MP2_MOD3_ITPE3_JEM.Models.RestaurantBill

@{
    ViewBag.Title = "Billing";
}

<h2>Billing</h2>
@using (Html.BeginForm("Billing", "Restaurant", FormMethod.Post))
{
    <table>
        <tr>
            <td>
                @Html.LabelFor(model => model.CNumJEM)
            </td>
            <td>
                @Html.TextBoxFor(model => model.CNumJEM)
                @Html.ValidationMessageFor(model => model.CNumJEM)
            </td>
        </tr>
        <tr>
            <td>
                @Html.LabelFor(model => model.LNameJEM)
            </td>
            <td>
                @Html.TextBoxFor(model => model.LNameJEM)
                @Html.ValidationMessageFor(model => model.LNameJEM)
            </td>
        </tr>
        <tr>
            <td>
                @Html.LabelFor(model => model.FNameJEM)
            </td>
            <td>
                @Html.TextBoxFor(model => model.FNameJEM)
                @Html.ValidationMessageFor(model => model.FNameJEM)
            </td>
        </tr>
        <tr>
            <td>
                @Html.LabelFor(model => model.CTypeJEM)
            </td>
            <td>
                @Html.TextBoxFor(model => model.CTypeJEM)
                @Html.ValidationMessageFor(model => model.CTypeJEM)
            </td>
        </tr>   
        <tr>
            <td>
                @Html.LabelFor(model => model.TAmountJEM)
            </td>
            <td>
                @Html.TextBoxFor(model => model.TAmountJEM)
                @Html.ValidationMessageFor(model => model.TAmountJEM)
            </td>
        </tr>      

        <tr>
            <td>@Html.LabelFor(m => m.TChargesJEM)</td>
            <td>@Html.TextBoxFor(m => m.TChargesJEM, new { @Value = ViewBag.TChargesJEM, @readonly = "readonly" })</td>
        </tr>
        <tr>
            <td>@Html.LabelFor(m => m.SChargesJEM)</td>
            <td>@Html.TextBoxFor(m => m.SChargesJEM, new { @Value = ViewBag.SChargesJEM, @readonly = "readonly" })</td>
        </tr>
        <tr>
            <td>@Html.LabelFor(m => m.TotChargesJEM)</td>
            <td>@Html.TextBoxFor(m => m.TotChargesJEM, new { @Value = ViewBag.TotChargesJEM, @readonly = "readonly" })</td>
        </tr>
        <tr>
            <td>@Html.LabelFor(m => m.TDiscountJEM)</td>
            <td>@Html.TextBoxFor(m => m.TDiscountJEM, new { @Value = ViewBag.TDiscountJEM, @readonly = "readonly" })</td>
        </tr>
        <tr>
            <td>@Html.LabelFor(m => m.APayJEM)</td>
            <td>@Html.TextBoxFor(m => m.APayJEM, new { @Value = ViewBag.APayJEM, @readonly = "readonly" })</td>
        </tr>
        <tr>
            <td></td>
            <td><input type="submit" value="COMPUTE AMOUNT"/></td>
        </tr>
    </table>
}