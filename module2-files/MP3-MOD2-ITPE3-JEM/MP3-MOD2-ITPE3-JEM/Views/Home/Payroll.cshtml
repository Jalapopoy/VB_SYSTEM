@{
    ViewBag.Title = "Payroll";
}

<h2>Payroll</h2>

@for (int i = 0; i <= 4; i++)
{
    <p>Employee Number: @ViewBag.ENumJEM[i]</p>
    <p>Employee Name: @ViewBag.FNameJEM[i] @ViewBag.LNameJEM[i]</p>
    <p>Marital Code: @ViewBag.MTCodeJEM[i]</p>
    <p>Hours Work: @ViewBag.HWorkJEM[i]</p>
    <p>Hours OT: @ViewBag.HOTJEM[i]</p>
    <p>Hours Late: @ViewBag.HLateJEM[i]</p>
    <p>Rate Per Hour @ViewBag.RPHourJEM[i]</p>
    <p>Total Deductions @ViewBag.TDeducJEM[i]</p>
    <p>Net Pay: @( ((( (int) ViewBag.HWorkJEM[i] + (int)ViewBag.HOTJEM[i]) - (int)ViewBag.HLateJEM[i]) * (int)ViewBag.RPHourJEM[i]) - (int)ViewBag.TDeducJEM[i] )</p>
    <br />
}