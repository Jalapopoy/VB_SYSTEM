@model IEnumerable<MvcJEMCRUD.Models.Student>

@{
    ViewBag.Title = "ReadAllStudent";
}

<h2>ReadAllStudent</h2>

<p>
    @Html.ActionLink("Create New", "CreateStudent")
</p>
<table>
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.LastName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.FirstName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.MiddleName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Address)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Course)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.LastName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.FirstName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.MiddleName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Address)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Course)
        </td>
        <td>
            @Html.ActionLink("Edit", "UpdateStudent", new { id=item.StudentID }) |
            @Html.ActionLink("Details", "ReadOneStudent", new { id=item.StudentID }) |
            @Html.ActionLink("Delete", "DeleteStudent", new { id=item.StudentID })
        </td>
    </tr>
}

</table>
