@model Barangay_System.Models.UserViewModel

@{
    ViewBag.Title = "User Details";
}
<br />
<h2 style="margin-left:10px">User Details</h2>
<br />

<dl class="row" style="margin-left:10px">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.UserID)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.UserID)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Username)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Username)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Role)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Role)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ResidentID)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.ResidentID)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Status)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.created_at)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.created_at)</dd>
</dl>

<p style="margin-left:10px">
    @Html.ActionLink("Edit", "Edit", new { id = Model.UserID }, new { @class = "btn btn-primary" })
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
</p>