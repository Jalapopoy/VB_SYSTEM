@model Barangay_System.Models.UserViewModel

@{
    ViewBag.Title = "Edit User";
}
<br />
<h2 style="margin-left:10px">Edit User</h2>
<br />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <table class="table">
        <tr>
            <td>@Html.LabelFor(model => model.UserID)</td>
            <td>
                @Html.TextBoxFor(model => model.UserID, null, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.UserID)
            </td>
        </tr>
        <tr>
            <td>@Html.LabelFor(model => model.Username)</td>
            <td>
                @Html.TextBoxFor(model => model.Username, null, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Username)
            </td>
        </tr>
        <tr>
            <td>@Html.LabelFor(model => model.Password)</td>
            <td>
                @Html.PasswordFor(model => model.Password, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Password)
            </td>
        </tr>
        <tr>
            <td>@Html.LabelFor(model => model.Role)</td>
            <td>
                @Html.DropDownListFor(model => model.Role,
                    new SelectList(new[] { "Admin", "Staff", "Resident" }),
                    "-- Select Role --", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Role)
            </td>
        </tr>
        <tr>
            <td>@Html.LabelFor(model => model.ResidentID)</td>
            <td>
                @Html.DropDownListFor(model => model.ResidentID, (SelectList)ViewBag.Residents,
                    "-- None (Admin / Staff) --", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.ResidentID)
            </td>
        </tr>
        <tr>
            <td>@Html.LabelFor(model => model.Status)</td>
            <td>
                @Html.DropDownListFor(model => model.Status,
                    new SelectList(new[] { "Active", "Inactive" }),
                    "-- Select Status --", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Status)
            </td>
        </tr>
        <tr>
            <td></td>
            <td>
                <button type="submit" class="btn btn-primary">Save User</button>
                @Html.ActionLink("Back to User List", "Index", null, new { @class = "btn btn-secondary" })
            </td>
        </tr>
    </table>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}