@model IEnumerable<Barangay_System.Models.DocumentTypeViewModel>

@{
    ViewBag.Title = "Document Type List";
}
<br />
<h2 style="margin-left:10px">Document Type List</h2>

<p style="margin-left:10px">
    @if ((Session["Role"] as string) == "Admin")
    {
    @Html.ActionLink("+ Add New Document Type", "Create", null, new { @class = "btn btn-primary" })
    }
</p>

<table class="table table-striped table-hover">
    <thead class="thead-dark">
        <tr>
            <th>Document Type ID</th>
            <th>Name</th>
            <th>Description</th>
            <th>Fee (PHP)</th>
            <th>Processing Days</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.DocTypeID)</td>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Description)</td>
                <td>@Html.DisplayFor(modelItem => item.Fee)</td>
                <td>@Html.DisplayFor(modelItem => item.ProcessingDays)</td>
                <td>
                    @Html.ActionLink("Details", "Details", new { id = item.DocTypeID }, new { @class = "btn btn-sm btn-info" })
                    @if ((Session["Role"] as string) == "Admin")
                    {
                    @Html.ActionLink("Edit", "Edit", new { id = item.DocTypeID }, new { @class = "btn btn-sm btn-primary" })
                    }
                    @if ((Session["Role"] as string) == "Admin")
                    {
                        @Html.ActionLink("Delete", "Delete", new { id = item.DocTypeID }, new { @class = "btn btn-sm btn-danger" })
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p style="margin-left:10px" class="text-muted">No document types found.</p>
}