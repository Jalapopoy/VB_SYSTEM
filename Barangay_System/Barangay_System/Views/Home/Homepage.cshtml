@{
    ViewBag.Title = "HomePage";
}

<main role="main">
    <div class="jumbotron">
        <div class="container">
            <h1 class="display-3">Hello, Welcome to Barangay Document Request System!</h1>
            <p>
                The Barangay Document Request System is a web-based system that lets residents request
                barangay documents such as clearances, certificates of residency, certificates of indigency,
                and business permits without lining up at the barangay hall. It keeps resident, household,
                request, and payment records in one database.
            </p>
            <p>
                Barangay staff can review each request, update its status from Pending to Approved or Released,
                and record payments and official receipt numbers. Residents can check the status of their
                requests at any time. This makes document processing faster, more organized, and easier to track
                for both the residents and the barangay office.
            </p>
        </div>
    </div>
</main>

<footer class="container">
    <p>&copy; Barangay Document Request System 2026</p>
</footer>