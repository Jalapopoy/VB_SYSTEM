@model Barangay_System.Models.ResidentViewModel

@{
    ViewBag.Title = "Create Resident";
}
<br />
<h2 style="margin-left:10px">Create Resident</h2>
<br />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    if (ViewBag.Message != null)
    {
        <div style="border:solid 1px green">
            @ViewBag.Message
        </div>
    }

    <table class="table">
        <tr>
            <td>@Html.LabelFor(model => model.ResidentID)</td>
            <td>
               @Html.TextBoxFor(model => model.ResidentID, new
                {
                    @class = "form-control",
                    @readonly = "readonly",
                })
                @Html.ValidationMessageFor(model => model.ResidentID)
            </td>
        </tr>
        <tr>
            <td>@Html.LabelFor(model => model.HouseholdID)</td>
            <td>
                @Html.DropDownListFor(
                    model => model.HouseholdID,
                    ViewBag.Households as SelectList,
                    "-- Select Household --",
                    new { @class = "form-control" }
                )
            </td>
        </tr>
        <tr>
            <td>@Html.LabelFor(model => model.FirstName)</td>
            <td>
                @Html.TextBoxFor(model => model.FirstName, null, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.FirstName)
            </td>
        </tr>
        <tr>
            <td>@Html.LabelFor(model => model.MiddleName)</td>
            <td>
                @Html.TextBoxFor(model => model.MiddleName, null, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.MiddleName)
            </td>
        </tr>
        <tr>
            <td>@Html.LabelFor(model => model.LastName)</td>
            <td>
                @Html.TextBoxFor(model => model.LastName, null, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.LastName)
            </td>
        </tr>
        <tr>
            <td>@Html.LabelFor(model => model.Birthdate)</td>
            <td>
                @Html.TextBoxFor(model => model.Birthdate, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Birthdate)
            </td>
        </tr>
        <tr>
            <td>@Html.LabelFor(model => model.Sex)</td>
            <td>
                @Html.DropDownListFor(model => model.Sex,
                    new SelectList(new[] { "Male", "Female" }),
                    "-- Select Sex --", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Sex)
            </td>
        </tr>
        <tr>
            <td>@Html.LabelFor(model => model.CivilStatus)</td>
            <td>
                @Html.DropDownListFor(model => model.CivilStatus,
                    new SelectList(new[] { "Single", "Married", "Widowed", "Separated" }),
                    "-- Select Civil Status --", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.CivilStatus)
            </td>
        </tr>
        <tr>
            <td>@Html.LabelFor(model => model.ContactNo)</td>
            <td>
                @Html.TextBoxFor(model => model.ContactNo, null, new { @class = "form-control", placeholder = "09XXXXXXXXX" })
                @Html.ValidationMessageFor(model => model.ContactNo)
            </td>
        </tr>
        <tr>
            <td>@Html.LabelFor(model => model.Email)</td>
            <td>
                @Html.TextBoxFor(model => model.Email, null, new { type = "email", @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Email)
            </td>
        </tr>
        <tr>
            <td>@Html.LabelFor(model => model.Occupation)</td>
            <td>
                @Html.TextBoxFor(model => model.Occupation, null,
                    new { @class = "form-control", list = "occupationList" })
                <datalist id="occupationList">
                    <option value="Student" />
                    <option value="Farmer" />
                    <option value="Fisherman" />
                    <option value="Vendor" />
                    <option value="Driver" />
                    <option value="Teacher" />
                    <option value="Government Employee" />
                    <option value="Private Employee" />
                    <option value="Self-Employed" />
                    <option value="Overseas Filipino Worker" />
                    <option value="Housewife" />
                    <option value="Retired" />
                    <option value="Unemployed" />
                </datalist>
                @Html.ValidationMessageFor(model => model.Occupation)
            </td>
        </tr>
        <tr>
            <td></td>
            <td>
                <button type="submit" class="btn btn-primary">Save Resident</button>
                @Html.ActionLink("Back to Resident List", "Index", null, new { @class = "btn btn-secondary" })
            </td>
        </tr>
    </table>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}