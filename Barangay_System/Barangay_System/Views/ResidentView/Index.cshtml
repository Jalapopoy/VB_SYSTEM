@model IEnumerable<Barangay_System.Models.ResidentViewModel>

@{
    ViewBag.Title = "Resident List";
}
<br />
<h2 style="margin-left:10px">Resident List</h2>

<p style="margin-left:10px">
    @Html.ActionLink("+ Add New Resident", "Create", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-striped table-hover">
    <thead class="thead-dark">
        <tr>
            <th>Resident ID</th>
            <th>Household ID</th>
            <th>Name</th>
            <th>Birthdate</th>
            <th>Sex</th>
            <th>Contact No.</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.ResidentID)</td>
                <td>@Html.DisplayFor(modelItem => item.HouseholdID)</td>
                <td>@item.LastName, @item.FirstName @item.MiddleName</td>
                <td>@Html.DisplayFor(modelItem => item.Birthdate)</td>
                <td>@Html.DisplayFor(modelItem => item.Sex)</td>
                <td>@Html.DisplayFor(modelItem => item.ContactNo)</td>
                <td>
                    @Html.ActionLink("Details", "Details", new { id = item.ResidentID }, new { @class = "btn btn-sm btn-info" })
                    @Html.ActionLink("Edit", "Edit", new { id = item.ResidentID }, new { @class = "btn btn-sm btn-primary" })
                    @if ((Session["Role"] as string) == "Admin")
                    {
                        @Html.ActionLink("Delete", "Delete", new { id = item.ResidentID }, new { @class = "btn btn-sm btn-danger" })
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p style="margin-left:10px" class="text-muted">No residents found.</p>
}